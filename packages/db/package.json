{
  "name": "@north/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "status": "supabase status",
    "reset": "supabase db reset",
    "types": "supabase gen types typescript --local --schema public > src/types.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo 'no unit tests in @north/db'",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@north/core": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "5.0.4"
  }
}
