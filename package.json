{
  "name": "north",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker,inngest -c blue,magenta,yellow \"pnpm --filter @north/web dev\" \"pnpm --filter @north/worker dev\" \"pnpm inngest:dev\"",
    "inngest:dev": "npx --yes inngest-cli@latest dev -u http://localhost:3100/api/inngest -u http://localhost:3101/api/inngest --no-discovery",
    "db:start": "pnpm --filter @north/db start",
    "db:stop": "pnpm --filter @north/db stop",
    "db:reset": "pnpm --filter @north/db reset",
    "db:types": "pnpm --filter @north/db types && prettier --write packages/db/src/types.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @north/db test:integration",
    "smoke": "tsx scripts/smoke.ts",
    "validate": "bash scripts/validate.sh",
    "e2e": "pnpm --filter @north/web e2e",
    "e2e:replay": "NORTH_CASSETTE_MODE=replay AGENT_RUNTIME=claude-agent-sdk NORTH_ENV=staging NORTH_MODEL_PROFILE=smoke pnpm --filter @north/web e2e",
    "e2e:prod": "pnpm --filter @north/web e2e:prod",
    "e2e:staging": "bash scripts/evidence-guard.sh --run pnpm --filter @north/web e2e:staging",
    "e2e:live": "bash scripts/evidence-guard.sh --run pnpm --filter @north/web e2e:live",
    "smoke:m1": "tsx scripts/smoke-m1.ts",
    "smoke:m2": "tsx scripts/smoke-m2.ts",
    "smoke:m3": "tsx scripts/smoke-m3.ts",
    "smoke:m4": "tsx scripts/smoke-m4.ts",
    "smoke:m5": "tsx scripts/smoke-m5.ts",
    "smoke:m6": "tsx scripts/smoke-m6.ts",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "evidence:costs": "tsx scripts/evidence-costs.ts",
    "cassette:check": "tsx scripts/cassette-check.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.mts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "production:check": "tsx scripts/production-check.ts",
    "staging:check": "tsx scripts/production-check.ts -- --env staging",
    "staging:purge-e2e": "tsx scripts/staging-purge-e2e.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "lighthouse:pwa": "bash scripts/lighthouse-pwa.sh",
    "purge:due": "tsx scripts/purge-due.ts",
    "sentry:project": "tsx scripts/set-sentry-project.ts"
  },
  "devDependencies": {
    "@north/agents": "workspace:*",
    "@north/core": "workspace:*",
    "@north/db": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "inngest": "4.24.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
