# North environment. Two processes, two files. Never give the web app a
# worker-only value: CI greps apps/web/src for them.
#
#   apps/web/.env.local  ← "web" lines
#   apps/worker/.env     ← "worker" lines
#
# Local values come from `pnpm db:start` (Docker) or `scripts/stack/up.sh` (.stack/env).

# ---- web + worker ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
INNGEST_DEV=1                   # local Dev Server (no keys needed); production uses the two keys below
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
INTEGRATIONS_MODE=sandbox       # sandbox | live (live keys are entered by the founder only)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY= # web: shows "Enable notifications" in /settings

# ---- worker only ----------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=      # worker only (and the e2e/smoke scripts through the shell env)
ANTHROPIC_API_KEY=              # worker only; read once, by the model gateway, when AGENT_RUNTIME=claude-agent-sdk (never given to an agent subprocess; blank = unset)
AGENT_RUNTIME=mock              # mock | claude-agent-sdk (needs ANTHROPIC_API_KEY unless NORTH_CASSETTE_MODE=replay)
WORKER_PORT=3101
# NODE_ENV=development          # development | test | production (default development; Fly's [env] and the Dockerfile set production, which needs INNGEST_SIGNING_KEY and arms the NORTH_ENV guards below)
# WORKER_HOST=127.0.0.1         # bind address; the sandbox simulation routes (/sandbox/ads/*, /sandbox/mail/*) exist only on a loopback host
# WORKSPACE_ROOT=.workspaces    # per-task workspaces, <root>/<task id> (default <cwd>/.workspaces; on Fly /data/workspaces); `pnpm purge:due` and `pnpm staging:purge-e2e` remove a purged owner's workspaces only when it is set
# AGENTS_DIR=../../agents       # the role YAML files (default <cwd>/../../agents; the image sets /app/agents); its parent is the repo root NORTH_CASSETTE_DIR resolves against
# SANDBOX_ROOT=.sandbox         # where sandbox repos and sites live; served at /sandbox/sites/* in sandbox mode
# SANDBOX_SITE_BASE_URL=http://127.0.0.1:3101

# Proactive layer (M5, ADR 0011/0013). The Sentry issue webhook lives in the worker (`POST /webhooks/sentry`);
# in sandbox mode the secret defaults to `sandbox-sentry-secret` so the smoke and e2e can sign.
# SENTRY_CLIENT_SECRET=         # from the Sentry internal integration; the sandbox default secret exists on a loopback WORKER_HOST only, otherwise the route is mounted only when set
# SENTRY_DSN=                   # the worker's own error reporting (@sentry/node); unset = off. The web's is NEXT_PUBLIC_SENTRY_DSN (below)
# NORTH_CLOCK_START=            # sandbox only: the dev worker's initial clock (ISO 8601); `POST /sandbox/clock { now }` moves it (loopback host only)

# Billing (M6, BIL-1/BIL-2, ADR 0014). The platform's Stripe account; the web never holds these (CI greps for them).
# Unset = the sandbox billing adapter: checkout and portal are pages on the worker (loopback only) and the webhook
# verifies with the sandbox default `whsec_sandbox`. The founder enters test-mode keys first (CLAUDE.md #5).
# STRIPE_SECRET_KEY=            # <your key>; with STRIPE_WEBHOOK_SECRET or neither (half a configuration stays in sandbox)
# STRIPE_WEBHOOK_SECRET=        # the signing secret of the endpoint `pnpm stripe:setup` registers at <worker>/webhooks/stripe
# The user's own Stripe read (OUT-2): North's Stripe Connect app, read_only scope. Without the id the settings page offers "Connect (sandbox)".
# STRIPE_CONNECT_CLIENT_ID=     # the Connect platform's client id (public, but only the worker exchanges the code today)
# STRIPE_CONNECT_CLIENT_SECRET= # worker only
# RETENTION_PURGE_ENABLED=0     # RET-1 (ADR 0016): 1 lets the daily sweep purge owners 90 days after their end; 0 (default) only marks purge_due for `pnpm purge:due`

# Model gateway (M7, SEC-1/TST-1/TST-2): with AGENT_RUNTIME=claude-agent-sdk the worker starts a loopback gateway that holds the real key,
# enforces the day's cap and records or replays cassettes. The agent subprocess and the single-call LLM client both go through it.
# NORTH_CASSETTE_MODE=off       # off | record | replay (default off: forward to the model API, store nothing); record/replay under NODE_ENV=production need NORTH_ENV=staging; see cassettes/README.md
# NORTH_CASSETTE_DIR=cassettes  # where record writes and replay reads (default <repo root>/cassettes; a relative path is read from the repo root)
# NORTH_DAILY_CAP_USD=0         # the gateway's spend cap per UTC day in USD (default 0 = no cap); seeded at boot with the day's agent_runs spend (a failed read seeds the full cap)
# ANTHROPIC_BASE_URL=           # the model API the gateway forwards to (default https://api.anthropic.com); loopback only under NODE_ENV=production
# AGENT_CONFIG_ROOT=            # per-company agent config dirs, each run's HOME (default <cwd>/.agent-config, blank = default, a relative path is read from the cwd; on Fly /data/agent-config)

# Deployment, model profile and test fence (M7, STG-1/TST-1/TST-5). /health reports env, profile, fence and gateway.
# NORTH_ENV=production          # production | staging (default production); only staging may run the fence or cassettes under NODE_ENV=production
# NORTH_MODEL_PROFILE=production # production | staging | smoke (cheaper models for tests); any profile in development, under NODE_ENV=production anything but production needs NORTH_ENV=staging
# NORTH_TEST_FENCE=0            # 0 | 1 (exactly; anything else fails boot): 1 blocks every outside target not on the lists below
# NORTH_FENCE_META_AD_ACCOUNTS= # comma-separated test ad account ids the fence allows (act_123 or 123; a malformed entry fails boot, as in the lists below)
# NORTH_FENCE_GITHUB_OWNERS=    # comma-separated test GitHub owners the fence allows
# NORTH_FENCE_RECIPIENT_DOMAINS= # comma-separated test mail domains the fence allows (subdomains too)
# NORTH_FENCE_VERCEL_PREFIX=e2e- # the Vercel project prefix the fence allows (default e2e-)

# Outreach compliance (M7, CMP-1): unsubscribe links and their signing secret.
# NORTH_WORKER_PUBLIC_URL=      # the public worker URL unsubscribe links point at; sandbox defaults to the worker's own URL, live mode under NODE_ENV=production requires it
# UNSUBSCRIBE_SECRET=           # worker only, 16+ characters; sandbox on a loopback WORKER_HOST defaults to `sandbox-unsubscribe-secret`, live mode without it keeps /u/{token} off and refuses every outreach send
# NORTH_TRUST_PROXY=0           # 1 only behind Fly's edge, which sets Fly-Client-IP (fly.toml sets 1): /u/{token} then counts failed requests (60 a minute) by that header, else by the socket address; X-Forwarded-For is never read

# Memory search (M7, LRN-7).
# NORTH_EMBED_QUERIES=0         # 1 embeds memory queries through the `embed` Edge Function in sandbox mode too (live mode always does); without an embedding, search goes by words

# Langfuse tracing (OBS-1): one trace per agent run, tool calls as spans; all three set or tracing stays off.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=          # worker only
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_REDACT=1             # 1 (default): no prompt text and no tool input leave the worker; 0 sends them

# Decision delivery (M2). All optional: without them push and email stay in sandbox and are
# recorded in `notifications`. Generate VAPID keys with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# RESEND_API_KEY=
# RESEND_FROM=North <decisions@your-domain>

# Connections (M3/M4, ONB-3 / ADR 0008 / ADR 0010). Without the ids the settings page offers "Connect (sandbox)".
# Ads and outreach run on the user's own Meta and Gmail connections; there are no platform ads keys (BUD-2).
# CONNECTIONS_ENCRYPTION_KEY=   # 32 bytes base64 (`openssl rand -base64 32`); required when INTEGRATIONS_MODE=live
# GITHUB_CLIENT_SECRET=         # GitHub OAuth app
# VERCEL_CLIENT_ID=             # Vercel integration client id
# VERCEL_CLIENT_SECRET=
# META_APP_SECRET=              # Meta app (development mode, founder as tester, a Meta sandbox ad account)
# GOOGLE_CLIENT_SECRET=         # Google OAuth client (Gmail send + readonly)

# ---- web only (public ids; the worker needs the ids too, for the token exchange and the Google refresh) ---
# GITHUB_CLIENT_ID=             # callback: $NEXT_PUBLIC_APP_URL/api/connections/github/callback
# GITHUB_OAUTH_SCOPE=repo       # `repo` creates private repositories; `public_repo` is narrower if public sites are fine
# VERCEL_INTEGRATION_SLUG=      # the Vercel integration's URL slug (install flow)
# META_APP_ID=                  # callback: $NEXT_PUBLIC_APP_URL/api/connections/meta_ads/callback
# GOOGLE_CLIENT_ID=             # callback: $NEXT_PUBLIC_APP_URL/api/connections/gmail/callback
# NEXT_PUBLIC_SENTRY_DSN=       # OBS-1: the web's own Sentry project (a public DSN); unset = @sentry/nextjs stays off
# SENTRY_AUTH_TOKEN=            # Vercel only, build time (source maps upload with SENTRY_ORG and SENTRY_PROJECT); never in a local file, never in the worker

# ---- staging (STG-1; docs/runbooks/staging.md) ------------------------------
# Every key the staging runbook sets, all commented: staging's own values, never production's, and never a
# local default. Worker keys go to `fly secrets set … --config apps/worker/fly.staging.toml`, whose [env] already
# sets NODE_ENV, WORKER_HOST, the /data roots, NORTH_ENV=staging, NORTH_TEST_FENCE=1, NORTH_MODEL_PROFILE=smoke,
# NORTH_DAILY_CAP_USD=1, AGENT_RUNTIME=claude-agent-sdk, INTEGRATIONS_MODE=live, NORTH_CASSETTE_MODE=off and
# NORTH_TRUST_PROXY=1. Web keys go to Vercel's `staging` environment (`vercel env add <NAME> staging`).
# Script keys stay in your shell or the GitHub environment `staging`.
#
# staging worker (Fly secrets)
# SUPABASE_URL=                  # https://<staging ref>.supabase.co (north-staging); the e2e purge reads it too
# SUPABASE_SERVICE_ROLE_KEY=     # north-staging's service role key; the e2e purge reads it too
# INNGEST_EVENT_KEY=             # Inngest environment `staging` (worker and web)
# INNGEST_SIGNING_KEY=           # Inngest environment `staging` (worker and web)
# NEXT_PUBLIC_APP_URL=           # https://staging.<web> (worker and web)
# NORTH_WORKER_PUBLIC_URL=       # https://north-worker-staging.fly.dev (unsubscribe links; required in live mode)
# ANTHROPIC_API_KEY=             # the `north-test` workspace's key ($50 limit), never production's
# CONNECTIONS_ENCRYPTION_KEY=    # a staging key (`openssl rand -base64 32`); required in live mode
# UNSUBSCRIBE_SECRET=            # 16+ characters, never the sandbox default
# STRIPE_SECRET_KEY=             # the Stripe sandbox's sk_test_ key (the fence allows no other)
# STRIPE_WEBHOOK_SECRET=         # the endpoint `pnpm stripe:setup` registers on the staging worker
# STRIPE_CONNECT_CLIENT_ID=      # the sandbox's Connect client (OUT-2)
# STRIPE_CONNECT_CLIENT_SECRET=  # worker only
# GITHUB_CLIENT_ID=              # the GitHub test org's staging OAuth app (worker and web)
# GITHUB_CLIENT_SECRET=          # worker only
# VERCEL_CLIENT_ID=              # the staging Vercel integration
# VERCEL_CLIENT_SECRET=          # worker only
# META_APP_ID=                   # the Meta app in development mode (worker and web)
# META_APP_SECRET=               # worker only
# GOOGLE_CLIENT_ID=              # the Google OAuth client in Testing: consent lapses every 7 days (worker and web)
# GOOGLE_CLIENT_SECRET=          # worker only
# NORTH_FENCE_META_AD_ACCOUNTS=  # act_<the Meta sandbox ad account id>
# NORTH_FENCE_GITHUB_OWNERS=     # the GitHub test org
# NORTH_FENCE_RECIPIENT_DOMAINS= # staging.<domain> (Resend's receiving domain, subdomains too)
# NORTH_FENCE_VERCEL_PREFIX=     # e2e- (the default)
# RESEND_API_KEY=                # a sending key limited to staging.<domain> (also Supabase Auth's SMTP password)
# RESEND_FROM=                   # North Staging <decisions@staging.<domain>>
# VAPID_PUBLIC_KEY=              # a staging pair, never production's
# VAPID_PRIVATE_KEY=             # worker only
# VAPID_SUBJECT=                 # mailto:<you>
# SENTRY_DSN=                    # optional: a staging worker project
# SENTRY_CLIENT_SECRET=          # optional: that project's issue webhook (PRO-2)
# LANGFUSE_PUBLIC_KEY=           # Langfuse project `north-staging`
# LANGFUSE_SECRET_KEY=           # worker only
# LANGFUSE_HOST=                 # https://cloud.langfuse.com
# NORTH_MODEL_PROFILE=           # a workflow's one-run override of [env] (staging or production), unset afterwards
# NORTH_DAILY_CAP_USD=           # the same override (3 or 10), unset afterwards
#
# staging web (Vercel `staging`), besides the "worker and web" lines above
# NEXT_PUBLIC_SUPABASE_URL=      # north-staging's URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # north-staging's publishable key
# INTEGRATIONS_MODE=             # live (the real Connect buttons; the worker enforces the mode)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=  # the staging pair's public key
# NEXT_PUBLIC_SENTRY_DSN=        # optional: a staging web project
# GITHUB_OAUTH_SCOPE=            # repo
# VERCEL_INTEGRATION_SLUG=       # the staging Vercel integration's slug
#
# staging scripts and CI (your shell or the GitHub environment `staging`; never the worker or the web)
# VERCEL_AUTOMATION_BYPASS_SECRET= # Deployment Protection's automation bypass; Playwright and `pnpm staging:check` send it to the web's origin only
# STRIPE_READ_KEY=               # optional: the sandbox's restricted read key for `pnpm staging:check`
# NORTH_USAGE_READ_KEY=          # optional: a key that may read `usage`, for the check's usage ratios (read by scripts/production-check.ts `configFrom`, environment only; unset = skip)
# NORTH_ENV=                     # staging: `pnpm staging:purge-e2e` refuses to run without it
# NORTH_PRODUCTION_SUPABASE_REF= # production's project ref: the purge refuses a SUPABASE_URL that contains it (unset: refuses unless --i-know-this-is-not-production)
# E2E_MAIL_DOMAIN=               # staging.<domain>, required by the purge: the live journey's sign-up host; the purge matches e2e-*@ exactly this host
# E2E_RESEND_KEY=                # a Resend key that may read received mail, for the magic-link reader only (Task 20)
# ANTHROPIC_TEST_API_KEY=        # repository secret: the north-test key for the per-PR LLM smoke
# STAGING_SUPABASE_URL=          # GitHub environment `staging`: north-staging's URL (workflows pass it as SUPABASE_URL to the e2e purge)
# STAGING_SERVICE_ROLE_KEY=      # GitHub environment `staging`: north-staging's service role key (passed as SUPABASE_SERVICE_ROLE_KEY)
#
# the live journey (`pnpm e2e:staging`, `pnpm e2e:live`; runbook section 15) and the e2e harness
# E2E_BASE_URL=                  # https://staging.<web>: the web under test; unset = a dry run (journeys skipped, never passed)
# E2E_SUPABASE_URL=              # https://<staging ref>.supabase.co: the magic link must point here (else NEXT_PUBLIC_SUPABASE_URL)
# E2E_MAIL_PROVIDER=             # mailpit (default, the local stack) | resend (required on staging): where the magic link is read
# E2E_MAIL_API=                  # the Mailpit API the local magic-link reader polls (default http://127.0.0.1:54324/api/v1; `scripts/stack/up.sh` exports its own in .stack/env)
# E2E_MAIL_FROM_DOMAIN=          # optional: drops received mail from any other sender domain (usually staging.<domain>)
# E2E_EVIDENCE_DATE=             # optional YYYY-MM-DD: the evidence folder's day for the journey and `pnpm evidence:costs` (default today, UTC)
# E2E_WORKER_URL=                # the worker the e2e harness reads, e.g. the replay check's /health (default http://localhost:3101)
# E2E_CHROMIUM_PATH=             # optional: a pre-installed Chromium for Playwright instead of the pinned download
#
# the checks, the LLM smoke and the cost evidence (your shell or CI)
# NORTH_CHECK_ENV=               # production | staging: the check's rules when --env is not given (`pnpm staging:check` passes --env staging)
# NORTH_WEB_URL=                 # the check's --web when the flag is not given
# NORTH_WORKER_URL=              # the check's --worker when the flag is not given, and the worker `pnpm smoke:llm` reads (default http://localhost:3101)
# INNGEST_BASE_URL=              # the Inngest the LLM smoke sends its events to (default http://localhost:8288)
# SUPABASE_ANON_KEY=             # scripts and integration tests: the anon key (else NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
# SMOKE_LLM_TIMEOUT_MS=          # how long the LLM smoke waits for its tasks (default 420000, at most 3600000)
# SMOKE_LLM_OUT=                 # where the LLM smoke writes its JSON (default docs/evidence/M7/smoke-llm.json; mock and replay runs write elsewhere)
# SMOKE_LLM_SHA=                 # the commit the LLM smoke records (else GITHUB_SHA, which Actions sets, else git)
# SMOKE_LLM_ALLOW_REMOTE_DB=     # 1 lets the LLM smoke create its user and company on a database that is not this machine (default: loopback only)
# EVIDENCE_ALLOW_REMOTE_DB=      # 1 lets `pnpm evidence:costs` read a database that is not this machine (the staging workflows set it)
# EVIDENCE_WORKER_URL=           # the worker whose /health profile `pnpm evidence:costs` records (unset: not read)
# EVIDENCE_COMPANY_SLUG=         # the company `pnpm evidence:costs` reads when --slug is not given
# EVIDENCE_SHA=                  # the commit `pnpm evidence:costs` records (else GITHUB_SHA, else git)
