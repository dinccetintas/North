# Copy to apps/web/.env.local and apps/worker/.env (values from `pnpm db:start` output locally)
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Inngest: local Dev Server (no keys needed) when INNGEST_DEV=1
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Agents
ANTHROPIC_API_KEY=
INTEGRATIONS_MODE=sandbox
AGENT_RUNTIME=mock            # mock | claude-agent-sdk
WORKER_PORT=3101
