# Copy to apps/web/.env.local and apps/worker/.env (values from `pnpm db:start` output locally)
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Inngest: local Dev Server (no keys needed) when INNGEST_DEV=1
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Agents
ANTHROPIC_API_KEY=
INTEGRATIONS_MODE=sandbox      # sandbox | live (live keys are entered by the founder only)
AGENT_RUNTIME=mock            # mock | claude-agent-sdk
WORKER_PORT=3101

# Decision delivery (M2). All optional: without them push and email stay in sandbox and are
# recorded in `notifications`. Generate VAPID keys with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # web: shows "Enable notifications" in /settings
# VAPID_PUBLIC_KEY=               # worker: same key
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# RESEND_API_KEY=
# RESEND_FROM=North <decisions@your-domain>
# META_ACCESS_TOKEN=              # M4; the live ads adapter is a stub until then
# META_AD_ACCOUNT_ID=

# Connections (M3, ONB-3 / ADR 0008). Without the ids the settings page offers "Connect (sandbox)".
# The web app gets the public ids only; the worker gets the secrets and the encryption key.
# GITHUB_CLIENT_ID=               # web + worker: GitHub OAuth app (callback: $NEXT_PUBLIC_APP_URL/api/connections/github/callback)
# GITHUB_CLIENT_SECRET=           # worker only
# VERCEL_INTEGRATION_SLUG=        # web: the Vercel integration's URL slug (install flow)
# VERCEL_CLIENT_ID=               # worker only: the same integration's client id
# VERCEL_CLIENT_SECRET=           # worker only
# CONNECTIONS_ENCRYPTION_KEY=     # worker only, 32 bytes base64 (`openssl rand -base64 32`); required when INTEGRATIONS_MODE=live
# SANDBOX_ROOT=.sandbox           # worker: where sandbox repos and sites live; served at /sandbox/sites/* in sandbox mode
# SANDBOX_SITE_BASE_URL=http://127.0.0.1:3101
